# =============================================================================
# BENCHMARK DE VERIFICACIÓN: WBS y ROBUSTEZ (POST-FIX) - DEV VERSION
# =============================================================================
cat("=============================================================================\n")
cat("VERIFICACIÓN DE PARCHES: RC_wbs, RC_robust y AR(0.3) (SOURCE LOADING)\n")
cat("=============================================================================\n\n")
# -----------------------------------------------------------------------------
# 1. SETUP Y GENERADORES
# -----------------------------------------------------------------------------
set.seed(42)
N_REPS <- 50
TOLERANCE_OFFLINE <- 15
# Definir ruta local del paquete
local_pkg_path <- "C:/Users/ROG/Music/RegimeChange"
# Cargar librerías externas
library(changepoint)
library(parallel)
library(doParallel)
library(foreach)
# Necesario para cargar paquetes desde fuente local
library(devtools)
if(requireNamespace("wbs", quietly=TRUE)) library(wbs)
if(requireNamespace("ecp", quietly=TRUE)) library(ecp)
# --- CARGAR TU PAQUETE DESDE LA RUTA LOCAL ---
cat(sprintf("Cargando RegimeChange desde: %s\n", local_pkg_path))
devtools::load_all(local_pkg_path, quiet = TRUE)
# Configurar Cluster
n_cores <- detectCores()
n_workers <- max(1, n_cores - 1)
cl <- makeCluster(n_workers)
registerDoParallel(cl)
# Cargar tu paquete desde la ruta EN LOS WORKERS
clusterExport(cl, "local_pkg_path", envir = environment())
clusterEvalQ(cl, {
library(devtools)
devtools::load_all(local_pkg_path, quiet = TRUE) # Carga desde C:/Users/ROG...
library(changepoint)
library(wbs)
library(ecp)
})
# --- FUNCIONES AUXILIARES ---
compute_f1 <- function(detected, true_cp, tolerance = 15) {
if (is.null(detected)) detected <- integer(0)
if (is.null(true_cp)) true_cp <- integer(0)
detected <- as.numeric(detected)
true_cp <- as.numeric(true_cp)
detected <- detected[!is.na(detected) & is.finite(detected)]
true_cp <- true_cp[!is.na(true_cp) & is.finite(true_cp)]
if (length(true_cp) == 0 && length(detected) == 0) return(1.0)
if (length(true_cp) == 0) return(0.0)
if (length(detected) == 0) return(0.0)
matched <- 0
used_detected <- rep(FALSE, length(detected))
used_true <- rep(FALSE, length(true_cp))
dist_matrix <- outer(detected, true_cp, function(a, b) abs(a - b))
sorted_idx <- order(as.vector(dist_matrix))
for (idx in sorted_idx) {
i <- ((idx - 1) %% length(detected)) + 1
j <- ((idx - 1) %/% length(detected)) + 1
if (dist_matrix[i, j] > tolerance) break
if (!used_detected[i] && !used_true[j]) {
matched <- matched + 1
used_detected[i] <- TRUE
used_true[j] <- TRUE
}
}
precision <- matched / length(detected)
recall <- matched / length(true_cp)
if (precision + recall == 0) return(0.0)
2 * precision * recall / (precision + recall)
}
# --- GENERADORES (Copiados del original) ---
gen_mean_change <- function(n_per_seg, delta, n_regimes = 2) {
means <- cumsum(c(0, rep(c(delta, -delta), length.out = n_regimes - 1)))
data <- unlist(lapply(means, function(m) rnorm(n_per_seg, m, 1)))
true_cp <- if (n_regimes > 1) cumsum(rep(n_per_seg, n_regimes - 1)) else integer(0)
list(data = data, true_cp = true_cp)
}
gen_var_change <- function(n_per_seg, ratio, n_regimes = 2) {
sds <- rep(c(1, sqrt(ratio)), length.out = n_regimes)
data <- unlist(lapply(sds, function(s) rnorm(n_per_seg, 0, s)))
true_cp <- if (n_regimes > 1) cumsum(rep(n_per_seg, n_regimes - 1)) else integer(0)
list(data = data, true_cp = true_cp)
}
gen_multi_cp <- function(n_per_seg, deltas) {
data <- unlist(lapply(deltas, function(m) rnorm(n_per_seg, m, 1)))
true_cp <- cumsum(rep(n_per_seg, length(deltas) - 1))
list(data = data, true_cp = true_cp)
}
gen_ar_with_change <- function(n_per_seg, delta, ar_coef, n_regimes = 2) {
n_total <- n_per_seg * n_regimes
ar_noise <- as.numeric(arima.sim(list(ar = ar_coef), n = n_total))
means <- rep(cumsum(c(0, rep(c(delta, -delta), length.out = n_regimes - 1))), each = n_per_seg)
data <- ar_noise + means
true_cp <- if (n_regimes > 1) cumsum(rep(n_per_seg, n_regimes - 1)) else integer(0)
list(data = data, true_cp = true_cp, ar = TRUE)
}
gen_contaminated <- function(n_per_seg, delta, contamination = 0.05, outlier_size = 10) {
data <- c(rnorm(n_per_seg, 0), rnorm(n_per_seg, delta))
n_out <- max(1, round(length(data) * contamination))
idx <- sample(length(data), n_out)
data[idx] <- data[idx] + sample(c(-1, 1), n_out, replace = TRUE) * outlier_size
list(data = data, true_cp = n_per_seg)
}
gen_heavy_tailed <- function(n_per_seg, delta, df = 3) {
scale_factor <- if (df > 2) sqrt((df - 2) / df) else 1
data <- c(rt(n_per_seg, df) * scale_factor, rt(n_per_seg, df) * scale_factor + delta)
list(data = data, true_cp = n_per_seg)
}
gen_mixed_distribution <- function(n_per_seg, delta, mix_prob = 0.1, mix_scale = 5) {
gen_mixed <- function(n, mean_val) {
normal_part <- rnorm(n, mean_val, 1)
contamination <- rbinom(n, 1, mix_prob)
contaminated <- rnorm(n, mean_val, mix_scale)
ifelse(contamination == 1, contaminated, normal_part)
}
data <- c(gen_mixed(n_per_seg, 0), gen_mixed(n_per_seg, delta))
list(data = data, true_cp = n_per_seg)
}
# Generador AR(0.3) con Cambio de Media (Específico para Test C)
gen_ar_change <- function(n_per_seg=200, delta=2, ar=0.3) {
n_total <- n_per_seg * 2
noise <- as.numeric(arima.sim(list(ar = ar), n = n_total))
means <- c(rep(0, n_per_seg), rep(delta, n_per_seg))
data <- noise + means
list(data = data, true_cp = n_per_seg)
}
clusterExport(cl, c("compute_f1", "gen_mean_change", "gen_var_change", "gen_multi_cp",
"gen_ar_with_change", "gen_contaminated", "gen_heavy_tailed",
"gen_mixed_distribution", "gen_ar_change", "TOLERANCE_OFFLINE"))
# =============================================================================
# TEST A: REPARACIÓN DE WBS (Comparando SOLO variantes WBS)
# =============================================================================
cat("\n--- INICIANDO TEST DE WBS (Fix de Threshold y Muestreo) ---\n")
scenarios_wbs <- list(
list(name = "Media Delta=1 (difícil)", gen = function() gen_mean_change(200, 1)),
list(name = "Media Delta=0.5 (muy difícil)", gen = function() gen_mean_change(200, 0.5)),
list(name = "Multi-CP (5 cambios)", gen = function() gen_multi_cp(80, c(0, 2, 0, 2, 0, 2)))
)
# Función Ejecutora MODIFICADA (Solo WBS vs RC_WBS)
run_wbs_check <- function(scenario_gen, rep_id, tolerance) {
set.seed(8000 + rep_id)
test_data <- scenario_gen()
x <- test_data$data
true_cp <- test_data$true_cp
results <- list()
# 1. Tu WBS Corregido (type="both")
results$RC_wbs <- tryCatch({
r <- wild_binary_segmentation(x, type = "both", penalty = "BIC", min_segment = 5, M = 2000)
if (is.null(r$changepoints)) integer(0) else as.integer(r$changepoints)
}, error = function(e) integer(0))
# 2. Tu WBS Corregido (type="mean")
results$RC_wbs_mean <- tryCatch({
r <- wild_binary_segmentation(x, type = "mean", penalty = "BIC", min_segment = 5, M = 2000)
if (is.null(r$changepoints)) integer(0) else as.integer(r$changepoints)
}, error = function(e) integer(0))
# 3. El Rival: wbs package
results$WBS_pkg <- tryCatch({
r <- wbs::wbs(x)
cp <- wbs::changepoints(r, Kmax = 10)$cpt.ic$mbic.penalty
if (is.null(cp)) integer(0) else as.integer(cp)
}, error = function(e) integer(0))
sapply(results, function(detected) compute_f1(detected, true_cp, tolerance))
}
clusterExport(cl, "run_wbs_check")
results_wbs <- list()
for (s_idx in seq_along(scenarios_wbs)) {
scenario <- scenarios_wbs[[s_idx]]
cat(sprintf("Procesando: %s...\n", scenario$name))
scenario_gen <- scenario$gen
clusterExport(cl, "scenario_gen", envir = environment())
# NOTA: Quitamos "RegimeChange" de .packages porque se cargó vía load_all en clusterEvalQ
rep_results <- foreach(rep_id = 1:N_REPS, .combine = rbind, .packages = c("wbs")) %dopar% {
run_wbs_check(scenario_gen, rep_id, TOLERANCE_OFFLINE)
}
results_wbs[[scenario$name]] <- colMeans(rep_results, na.rm = TRUE)
}
cat("\nRESULTADOS WBS (Deberían ser > 0.60 y cercanos a WBS_pkg):\n")
print(do.call(rbind, results_wbs))
# =============================================================================
# TEST B: REPARACIÓN DE ROBUSTEZ (Comparando RC_auto vs ECP/Standard)
# =============================================================================
cat("\n\n--- INICIANDO TEST DE ROBUSTEZ (Fix de Escala Sigma) ---\n")
scenarios_robust_check <- list(
list(name = "Limpio (Control)", gen = function() gen_mean_change(200, 2)),
list(name = "5% Outliers", gen = function() gen_contaminated(200, 2, 0.05, 10)),
list(name = "Mixture (10%)", gen = function() gen_mixed_distribution(200, 2, 0.10, 5))
)
# Función Ejecutora MODIFICADA (Solo Robustez)
run_robust_check <- function(scenario_gen, rep_id, tolerance) {
set.seed(11000 + rep_id)
test_data <- scenario_gen()
x <- test_data$data
true_cp <- test_data$true_cp
results <- list()
# 1. Baseline: PELT Estándar (Fallará en outliers)
results$CP_standard <- tryCatch({
r <- cpt.meanvar(x, method = "PELT", penalty = "MBIC", minseglen = 5)
cpts(r)
}, error = function(e) integer(0))
# 2. Tu Fix: RC Auto (Debe ser alto ahora)
results$RC_auto <- tryCatch({
r <- detect_pelt(x, type="both", penalty="MBIC", min_segment=5, robust="auto")
if (is.null(r$changepoints)) integer(0) else as.integer(r$changepoints)
}, error = function(e) integer(0))
# 3. Tu Fix: RC Robust Explicit (Debe ser alto)
results$RC_robust <- tryCatch({
r <- detect_pelt(x, type="both", penalty="MBIC", min_segment=5, robust=TRUE)
if (is.null(r$changepoints)) integer(0) else as.integer(r$changepoints)
}, error = function(e) integer(0))
# 4. El Rival a batir: ECP
results$ECP_pkg <- tryCatch({
r <- ecp::e.divisive(matrix(x, ncol = 1), sig.lvl = 0.05, min.size = 10, R = 199)
cp <- r$estimates[-c(1, length(r$estimates))]
if (length(cp) == 0) integer(0) else as.integer(cp)
}, error = function(e) integer(0))
sapply(results, function(d) compute_f1(d, true_cp, tolerance))
}
clusterExport(cl, "run_robust_check")
results_robust_final <- list()
for (s_idx in seq_along(scenarios_robust_check)) {
scenario <- scenarios_robust_check[[s_idx]]
cat(sprintf("Procesando: %s...\n", scenario$name))
scenario_gen <- scenario$gen
clusterExport(cl, "scenario_gen", envir = environment())
# NOTA: Quitamos "RegimeChange" de .packages porque se cargó vía load_all en clusterEvalQ
rep_results <- foreach(rep_id = 1:N_REPS, .combine = rbind, .packages = c("changepoint", "ecp")) %dopar% {
run_robust_check(scenario_gen, rep_id, TOLERANCE_OFFLINE)
}
results_robust_final[[scenario$name]] <- colMeans(rep_results, na.rm = TRUE)
}
cat("\nRESULTADOS ROBUSTEZ (RC_auto y RC_robust deben estar cerca de 1.0):\n")
print(do.call(rbind, results_robust_final))
# =============================================================================
# TEST C: BENCHMARK ESPECÍFICO WBS en Series Autoregresivas (AR 0.3)
# Objetivo: Llenar el dato faltante "N/A" del reporte final
# =============================================================================
cat("\n\n--- INICIANDO TEST ESPECÍFICO: AR(0.3) + Cambio (50 reps) ---\n")
results_ar <- foreach(i = 1:N_REPS, .combine = rbind, .packages = c("wbs")) %dopar% {
set.seed(9000 + i)
sim <- gen_ar_change(n_per_seg = 200, delta = 2, ar = 0.3)
x <- sim$data
true_cp <- sim$true_cp
# A) Tu RegimeChange (WBS arreglado)
rc_try <- tryCatch({
r <- wild_binary_segmentation(x, type = "mean", penalty = "BIC", min_segment = 5, M = 2000)
if(is.null(r$changepoints)) integer(0) else as.integer(r$changepoints)
}, error = function(e) integer(0))
# B) Paquete 'wbs' (Referencia)
wbs_try <- tryCatch({
r <- wbs::wbs(x)
cp <- wbs::changepoints(r, Kmax = 10)$cpt.ic$mbic.penalty
if(is.null(cp)) integer(0) else as.integer(cp)
}, error = function(e) integer(0))
# C) Tu RegimeChange (PELT) - Control
pelt_try <- tryCatch({
r <- detect_pelt(x, penalty="MBIC")
if(is.null(r$changepoints)) integer(0) else as.integer(r$changepoints)
}, error = function(e) integer(0))
c(
RC_wbs_F1 = compute_f1(rc_try, true_cp, TOLERANCE_OFFLINE),
WBS_pkg_F1 = compute_f1(wbs_try, true_cp, TOLERANCE_OFFLINE),
RC_pelt_F1 = compute_f1(pelt_try, true_cp, TOLERANCE_OFFLINE)
)
}
# RESULTADOS AR
means_ar <- colMeans(results_ar, na.rm = TRUE)
sds_ar <- apply(results_ar, 2, sd, na.rm = TRUE)
cat("\n========================================================\n")
cat("RESULTADOS FINALES: AR(0.3) + Cambio de Media (Delta=2)\n")
cat("========================================================\n\n")
print(round(rbind(Promedio = means_ar, SD = sds_ar), 3))
cat("\nInterpretación:\n")
if (means_ar["RC_wbs_F1"] > 0.9) {
cat("✅ ÉXITO TOTAL: El fix de WBS maneja perfectamente la autocorrelación leve.\n")
} else if (means_ar["RC_wbs_F1"] > 0.8) {
cat("⚠️ ACEPTABLE: Buen rendimiento, aunque la AR afecta un poco.\n")
} else {
cat("❌ PROBLEMA: La autocorrelación sigue confundiendo al algoritmo.\n")
}
# Finalizar Cluster
stopCluster(cl)
setwd("C:/Users/ROG/Documents/SignalY")
devtools::build()
